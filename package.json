{
  "name": "pdf-adobe-ocr",
  "version": "2.1.0",
  "description": "Gescannte PDFs über die Adobe PDF Services API mit einem OCR-Textlayer versehen",
  "private": true,
  "license": "MIT",
  "scripts": {
    "ocr": "tsx src/index.ts",
    "serve": "tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke-refine.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "^4.1.0",
    "@anthropic-ai/sdk": "^0.127.0",
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.2.1",
    "log4js": "^6.9.1",
    "multer": "^2.4.0",
    "openai": "^7.20.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
