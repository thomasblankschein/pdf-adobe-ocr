# Zugangsdaten aus der Adobe Developer Console (PDF Services API, Projekt-Credentials)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# --- nur für den API-Server (docker compose) ---
# Externer Port auf dem Host
PORT=3000
# API-Key für /api/*; leer = kein Schutz (nur in vertrauenswürdigen Netzen!)
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
# Maximale Upload-Größe in MB (Adobe-Limit für OCR: 100)
MAX_UPLOAD_MB=100
# Logging (stdout/stderr → `docker compose logs -f`): debug | info | warn | error
LOG_LEVEL=info
# json (Standard im Container) | text (lesbar, Standard bei lokalem Start)
# LOG_FORMAT=text

# --- LLM-Nachbearbeitung (optional) ---
# Anbieter und Modell legt der Betreiber hier fest; per API wird nur ein/aus gewählt (Feld "llm=true").
# LLM_PROVIDER: anthropic | openai (leer = LLM-Nachbearbeitung nicht verfügbar)
LLM_PROVIDER=
# LLM_MODEL: Modellname des Anbieters. Standard nur bei anthropic (claude-opus-5); bei openai Pflicht.
LLM_MODEL=
# API-Key des gewählten Anbieters
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Seiten, die parallel an das Modell gehen
# LLM_CONCURRENCY=3
# Lange Kante des Seitenbilds in Pixeln, das an das Modell geht
# LLM_IMAGE_MAX_PX=2000
# Maximale Seitenzahl pro Request mit LLM (Kostenschutz)
# LLM_MAX_PAGES=50
# Maximale Textboxen pro Modellaufruf; größere Seiten werden aufgeteilt
# LLM_MAX_BOXES_PER_CALL=800
# Timeout je Modellaufruf in Sekunden
# LLM_TIMEOUT_S=180
