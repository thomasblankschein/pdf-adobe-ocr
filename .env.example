# Zugangsdaten aus der Adobe Developer Console (PDF Services API, Projekt-Credentials)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# --- nur für den API-Server (docker compose) ---
# Externer Port auf dem Host
PORT=3000
# API-Key für /api/*; leer = kein Schutz (nur in vertrauenswürdigen Netzen!)
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
# Maximale Upload-Größe in MB (Adobe-Limit für OCR: 100)
MAX_UPLOAD_MB=100
# Logging (stdout/stderr → `docker compose logs -f`): debug | info | warn | error
LOG_LEVEL=info
# json (Standard im Container) | text (lesbar, Standard bei lokalem Start)
# LOG_FORMAT=text
