# OCR-Engine: adobe (Standard) oder tesseract (ohne Adobe, lokal im Container)
# OCR_ENGINE=adobe
# tesseract: bei erschöpftem Adobe-Kontingent automatisch ausweichen (tesseract | none)
# OCR_FALLBACK=tesseract
# Tesseract-Feineinstellung: Sprachen (z. B. deu+eng), Auflösung, Seitensegmentierung, Mindest-Sicherheit
# TESSERACT_LANGS=
# TESSERACT_DPI=300
# TESSERACT_PSM=3
# TESSERACT_MIN_CONF=10
# größte Schräglage (Grad), die bei type=deskew ausgeglichen wird
# TESSERACT_DESKEW_MAX=10
# type=deskew: Seite begradigt ausgeben (true) oder nur fürs Erkennen begradigen, Original bleibt (false)
# TESSERACT_DESKEW_OUTPUT=true
# JPEG-Qualität der begradigten Seiten
# TESSERACT_JPEG_QUALITY=85

# Zugangsdaten aus der Adobe Developer Console (PDF Services API, Projekt-Credentials)
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# --- nur für den API-Server (docker compose) ---
# Externer Port auf dem Host
PORT=3000
# API-Key für /api/*; leer = kein Schutz (nur in vertrauenswürdigen Netzen!)
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
# Maximale Upload-Größe in MB (Adobe-Limit für OCR: 100)
MAX_UPLOAD_MB=100
# Logging (stdout/stderr → `docker compose logs -f`): debug | info | warn | error
LOG_LEVEL=info
# json (Standard im Container) | text (lesbar, Standard bei lokalem Start)
# LOG_FORMAT=text

# --- LLM-Nachbearbeitung (optional) ---
# Anbieter und Modell legt der Betreiber hier fest; per API wird nur ein/aus gewählt (Feld "llm=true").
# LLM_PROVIDER: anthropic | openai (leer = LLM-Nachbearbeitung nicht verfügbar)
LLM_PROVIDER=
# LLM_MODEL: Modellname des Anbieters. Standard nur bei anthropic (claude-opus-5); bei openai Pflicht.
LLM_MODEL=
# API-Key des gewählten Anbieters
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Namen, Adressen und Mailadressen des Empfängers (durch ; getrennt). Für meta=true: das Modell nennt den
# Absender als Korrespondenten, nie den Empfänger. Beispiel: OWN_NAMES=Max Muster; Musterweg 1, 12345 Musterstadt
OWN_NAMES=
# Seiten, die parallel an das Modell gehen
# LLM_CONCURRENCY=3
# Lange Kante des Seitenbilds in Pixeln, das an das Modell geht
# LLM_IMAGE_MAX_PX=2576
# Maximale Seitenzahl, bis zu der ein Dokument LLM-korrigiert wird (Kostenschutz); längere laufen mit lenient=true nur per Adobe

# LLM_MAX_PAGES=50
# Seiten mit unbrauchbarer Adobe-Textebene (Rauschen) komplett vom Modell transkribieren lassen (true/false)
# LLM_TRANSCRIBE=true
# Maximale Textboxen pro Modellaufruf; größere Seiten werden aufgeteilt
# LLM_MAX_BOXES_PER_CALL=250
# Korrekturdurchgänge je Seite (1-5): ein weiterer folgt nur, wenn der vorige viele Boxen geändert hat
# LLM_MAX_PASSES=3
# Timeout je Modellaufruf in Sekunden
# LLM_TIMEOUT_S=180
